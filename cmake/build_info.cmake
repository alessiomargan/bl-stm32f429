find_package(Git QUIET)
function(git_value output)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" ${ARGN}
        OUTPUT_VARIABLE value OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    set(${output} "${value}" PARENT_SCOPE)
endfunction()
git_value(GIT_HASH rev-parse --short HEAD)
git_value(GIT_COMMIT_HASH rev-parse HEAD)
git_value(GIT_BRANCH rev-parse --abbrev-ref HEAD)
git_value(GIT_TAG describe --tags --exact-match)
git_value(GIT_REPO_URL remote get-url origin)
git_value(dirty status --porcelain)
set(GIT_DIRTY 0)
if(dirty)
    set(GIT_DIRTY 1)
endif()
string(TIMESTAMP BUILD_TIMESTAMP "%Y-%m-%d %H:%M:%S")
string(TIMESTAMP BUILD_SHORT_TS "%y%m%d%H")
cmake_host_system_information(RESULT BUILD_HOST QUERY HOSTNAME)
set(BUILD_USER "$ENV{USER}")
set(BUILD_OS "${CMAKE_HOST_SYSTEM_NAME} ${CMAKE_HOST_SYSTEM_VERSION}")
set(content "/* Generated by CMake; do not edit. */\n#pragma once\n")
foreach(key BUILD_TIMESTAMP BUILD_SHORT_TS GIT_HASH GIT_COMMIT_HASH GIT_BRANCH GIT_TAG GIT_REPO_URL BUILD_HOST BUILD_USER BUILD_OS)
    string(REPLACE "\\" "\\\\" value "${${key}}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(APPEND content "#define ${key} \"${value}\"\n")
endforeach()
string(APPEND content "#define GIT_DIRTY ${GIT_DIRTY}\n")
get_filename_component(output_dir "${OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
file(WRITE "${OUTPUT_FILE}.tmp" "${content}")
configure_file("${OUTPUT_FILE}.tmp" "${OUTPUT_FILE}" COPYONLY)
file(REMOVE "${OUTPUT_FILE}.tmp")
